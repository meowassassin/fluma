{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shortsforge/storyboard/v1",
  "title": "Storyboard",
  "description": "영상 1편의 내용. 템플릿은 이 구조만 읽는다 (템플릿과의 계약).",
  "type": "object",
  "required": [
    "id",
    "version",
    "format",
    "duration_sec",
    "title",
    "scenes",
    "cta"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]*\\d{2}$"
    },
    "version": {
      "const": 1
    },
    "audience": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": "대상 시청자 (자유 문장). 조사·문체 기준. 2026-10-28 channel 대체"
    },
    "engine": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "craft",
        null
      ],
      "description": "화면 합성 엔진 — craft(Craft 앱 파이프라인: 재료 → EffectCraft → SoundCraft → FilmCraft). HyperFrames · Blender · Manim 은 2026-11-06 제거"
    },
    "template": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "엔진의 템플릿 이름. 없으면 형식으로 자동"
    },
    "format": {
      "enum": [
        "concept",
        "mythbust",
        "compare",
        "countdown",
        "fix",
        "series",
        "ad",
        "emotional",
        "daily",
        "ranking",
        "clip"
      ],
      "description": "ranking=퍼온 클립 순위 모음(상단 고정 제목 · 순위표 · 반응 자막, 나레이션 없음), clip=클립 하나 반응(제목 · 원본 말 자막), concept=한 개념 설명, mythbust=오해 깨기, compare=비교·대결, countdown=순위, fix=문제→해결, series=30초 3부작 중 1편, ad=광고(고민→제안→증거 수치→CTA), emotional=감성(현장 장면 + 짧은 문장, 숫자 최소), daily=당일 데이터(현장 + 가격 하나 + 반응)"
    },
    "brand": {
      "type": [
        "string",
        "null"
      ],
      "description": "화면 하단에 표시할 브랜드·채널 이름 (선택). 예: 호주에서 온 회전초밥"
    },
    "badge": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": "우상단 고정 배지 (예: '창업 15초', '오늘 시세'). 없으면 null"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "시안의 제약 (예: '유튜브 영상 스틸만 사용'). 생성층·렌더층이 읽는다"
    },
    "duration_sec": {
      "type": "integer",
      "minimum": 15,
      "maximum": 60
    },
    "title": {
      "type": "string",
      "maxLength": 40,
      "description": "유튜브 제목 (해시태그 제외)"
    },
    "topic": {
      "type": "string",
      "description": "입력된 주제 원문"
    },
    "hook_number": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 6,
      "description": "숫자 도장용 핵심 숫자 (예: '37%', '3개', '0원'). 없으면 null"
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "cta": {
      "type": "string",
      "maxLength": 20
    },
    "caption": {
      "type": "string",
      "maxLength": 300,
      "description": "플랫폼 게시글 본문"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#"
      },
      "maxItems": 10
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "of": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "생성 과정 기록. 템플릿은 읽지 않는다.",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "llm_calls": {
          "type": "integer"
        },
        "escalated": {
          "type": "boolean"
        },
        "lint_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "character": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9-]+$",
      "description": "data/characters/<이름>/ — 화면 구석에서 나레이션에 맞춰 립싱크하는 캐릭터. null 이면 끔"
    },
    "reference": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "참고한 트렌드 쇼츠 id (data/public/trends/analysis/<id>.json) — 편집기에 참고 리듬으로 표시"
    },
    "aspect": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ],
      "description": "출력 화면 비율(기본 9:16 쇼츠). 렌더 옵션 --aspect 가 우선. 같은 콘티로 여러 비율을 뽑을 수 있다"
    },
    "variants": {
      "type": "array",
      "maxItems": 4,
      "description": "비교용 버전(engine/story/variants.py): 훅 · 첫 장면 · 제목만 바꾼 2~4개를 초안으로 뽑아 나란히 본다. scenes 는 장면 번호(1부터) → 바꿀 칸만",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "scenes": {
            "type": "object"
          }
        }
      }
    },
    "direction": {
      "type": "object",
      "description": "디자인 방향 — 효과 · 배치 · 소리를 영상마다 정한다(engine/craft/design.py). 사용자가 정한 값 > 레퍼런스에서 잰 값(direct.py --write) > 효과 없음. 시안 고르기: engine/story/directions.py propose · pick(locked). 그 밖의 칸(색 · 바탕 · pin …)은 글자 · 참거짓 · 숫자",
      "properties": {
        "bg_preset": {
          "type": [
            "string",
            "null"
          ],
          "description": "EffectCraft 내장 배경 id 또는 null"
        },
        "bg_motion": {
          "type": "boolean"
        },
        "enter": {
          "type": [
            "string",
            "object",
            "null"
          ],
          "description": "재료 등장 전환 — 프리셋 id · {재료 종류: id} · null(바로 보임)"
        },
        "title_preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "sub_preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_pop": {
          "type": "boolean",
          "description": "제목 · 자막이 나올 때 살짝 커짐"
        },
        "cam_push": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.3,
          "description": "장면 내내 천천히 밀기 배율(1 = 없음)"
        },
        "frame": {
          "type": "object",
          "description": "실제 화면 액자 {shadow, round, push}"
        },
        "layout": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "full",
            "card",
            "band",
            null
          ]
        },
        "subs": {
          "type": "object",
          "description": "자막 모양 {box, bg, fg, hot, y}"
        },
        "title": {
          "type": "object",
          "description": "제목 모양 {box, bg, fg, y}"
        },
        "sound": {
          "type": "object",
          "description": "{voice_chain: clean|light|none, duck_db}"
        },
        "methods": {
          "type": "object",
          "description": "{재료 종류: 앱} — 같은 재료를 어느 앱으로(materials.methods())",
          "additionalProperties": {
            "type": "string"
          }
        },
        "locked": {
          "type": "boolean",
          "description": "사용자가 시안을 골라 고정 — direct.py 가 자동으로 바꾸지 않는다"
        },
        "picked": {
          "type": "string"
        },
        "design_from": {
          "type": "string",
          "enum": [
            "reference",
            "none",
            "motion",
            "user"
          ]
        },
        "_auto": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "direct.py 가 레퍼런스에서 자동으로 채운 칸"
        },
        "art": {
          "type": "object",
          "description": "이 영상의 시각 언어: palette{bg, ink, accent} · rule · avoid[]"
        },
        "color_bg": {
          "type": "string"
        },
        "feel": {
          "type": "object",
          "description": "고른 느낌(engine/story/feel.py pick — 사용자가 고를 때만): 실사 재료에 입힐 색 · 질감(grade)과 실사 생성 프롬프트의 style · mood · color · lighting",
          "properties": {
            "name": {
              "type": "string"
            },
            "why": {
              "type": "string"
            },
            "style_en": {
              "type": "string"
            },
            "mood_en": {
              "type": "string"
            },
            "color_en": {
              "type": "string"
            },
            "lighting_en": {
              "type": "string"
            },
            "grade": {
              "type": "object"
            }
          }
        },
        "route": {
          "enum": [
            "local",
            "mixed",
            "gen"
          ],
          "description": "실사 생성 여부: local = 실제 자료만 · mixed = 일부 컷만 생성(프롬프트) · gen = 대부분 생성"
        },
        "gen_scenes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "mixed 일 때 생성할 장면 번호(1부터)"
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "null",
          "boolean",
          "number"
        ]
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "description": "나레이션 음성 엔진 · 목소리 (engine/voice/engines/<엔진>). 없으면 설정의 기본 음성",
      "properties": {
        "engine": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.6,
          "description": "말 속도 (1 = 엔진 기본). 엔진이 직접 빠르게 말한다"
        },
        "style": {
          "type": "string",
          "maxLength": 400,
          "description": "말투 지시(글). 오픈라우터 음성 중 연기 지시(instructions)를 받는 모델에 넘긴다 — 예: 친구한테 소식 전하듯 빠르고 가볍게"
        },
        "continuous": {
          "type": "boolean",
          "description": "이어 말하기: 대본 전체를 한 번에 합성하고 장면은 단어 사이 쉼에서 자른다(컷이 바뀌어도 말이 이어짐)"
        },
        "ending": {
          "type": "string",
          "enum": [
            "keep",
            "period"
          ],
          "description": "말끝 처리(모든 엔진): period = 합성할 때만 문장 중간 쉼표를 마침표로 — 말끝이 올라가지 않고 떨어져 더 딱딱 · 담담하게. 자막 글은 그대로"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "감정 강도(예전 Typecast 전용 — 지금 엔진은 쓰지 않음)"
        },
        "pitch": {
          "type": "integer",
          "minimum": -12,
          "maximum": 12,
          "description": "음높이(반음, 예전 Typecast 전용 — 지금 엔진은 쓰지 않음)"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "description": "의도 카드 — 사용자가 원하는 것을 구조로 적는다(기억이 아니라 이 영상의 규칙). 확인(confirmed)되기 전엔 제작 · 유료 생성을 하지 않는다",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 300,
          "description": "한 줄: 누구에게 무엇을 어떤 느낌으로"
        },
        "reference_use": {
          "type": "string",
          "maxLength": 300,
          "description": "레퍼런스에서 가져올 것(구성 · 말투 · 화면 · 목소리 중 무엇을)과 가져오지 않을 것"
        },
        "must": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "꼭 지킬 것 — 사용자 지적이 나올 때마다 한 줄씩 더한다"
        },
        "must_not": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "하지 말 것 — 예: 직접 그린 2D · 이모지(AI 티) · 빨간 네모 강조"
        },
        "locked": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "content",
              "tone",
              "screen",
              "voice",
              "length"
            ]
          },
          "description": "사용자가 확정해 바꾸면 안 되는 축 — content 가 잠기면 말투 수정은 tone_edit.py 로만"
        },
        "confirmed": {
          "type": "boolean",
          "description": "사용자가 의도 카드를 확인했는지(gate.py intent 로만 켠다)"
        }
      }
    },
    "preset": {
      "type": "object",
      "description": "형식 프리셋(engine/research/format_presets.py pick) — 사람이 편집한 실제 쇼츠에서 잰 숫자: 자막 위치 · 크기 · 글자 수, 고정 제목, 화면 채움, 컷 길이, 화면 종류 비율. 화면 부품(K.talk · K.fmt)이 이 숫자로 배치한다",
      "additionalProperties": true
    },
    "language": {
      "type": "string",
      "enum": [
        "ko",
        "en",
        "zh"
      ],
      "default": "ko",
      "description": "나레이션 · 자막 언어(화면 UI 언어와 별개). 말 속도 검사 · 자막 줄 길이 · 말투 검사가 이것을 따른다"
    },
    "punchline": {
      "type": "string",
      "maxLength": 40,
      "description": "영상 내내 떠 있는 고정 펀치라인(참고 쇼츠 문법에 punch 자리가 있을 때) — 예: '아빠는 하품할때만 우는데'"
    },
    "grammar": {
      "type": "object",
      "additionalProperties": true,
      "description": "참고 쇼츠의 화면 문법(engine/story/previz.py grammar): 고정 제목 · 펀치라인 · 상황 괄호 · 반응 자막 · 속마음 · 영상 칸의 위치 · 크기 · 색. K.talk.gram 이 읽는다"
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "description": "배경음악(engine/core/finish.py 가 마무리 때 섞는다). 권리는 사용자 판단 — 엔진은 사용자가 지정한 파일만 섞는다",
      "properties": {
        "src": {
          "type": "string",
          "description": "음악 파일 경로(저장소 기준, 예: data/public/uploads/<id>/song.mp3)"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "곡의 몇 초부터 쓸지(후렴 · 드롭에 맞추기) — ffmpeg 마무리만 씀(Craft 엔진은 처음부터)"
        },
        "gain_db": {
          "type": "number",
          "minimum": -40,
          "maximum": 6,
          "description": "음량(dB). 기본 -14 — 나레이션이 있으면 그 밑에 깔린다"
        },
        "duck": {
          "type": "boolean",
          "description": "말할 때 음악을 줄인다(기본 true)"
        },
        "fade_in": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "fade_out": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "끝 페이드 아웃 초(Craft 엔진은 s-curve, 기본 1.5)"
        },
        "duck_db": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "description": "말하는 동안 더 내릴 dB(Craft 엔진 SoundCraft, 기본 -5)"
        }
      }
    },
    "synthetic": {
      "type": "boolean",
      "description": "사실적인 합성 장면이 있을 때 업로드에 AI 합성 표시를 켠다"
    },
    "refine": {
      "type": "array",
      "description": "영상 전체 다듬기(소리 마스터 · 편집 · Main 컴프)",
      "items": {
        "$ref": "#/$defs/refine_pass"
      }
    },
    "reference_skip": {
      "type": "string",
      "description": "레퍼런스 없이 만들 때 사용자의 말 — 검사 L30 을 넘긴다"
    },
    "concept": {
      "type": "object",
      "description": "사용자가 고른 콘셉트(engine/story/concepts.py pick)"
    },
    "credits": {
      "type": "object"
    },
    "kind": {
      "type": "string"
    },
    "music_library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track"
      ],
      "description": "업로드 때 유튜브 쇼츠 편집기(오디오 라이브러리)에서 붙일 곡 — 영상 파일에는 넣지 않는다(유튜브가 라이선스를 가진 곡이라 수익 문제가 없다). engine/research/trend_music.py 로 같은 분야 쇼츠가 실제로 붙이는 곡을 찾아 고른다",
      "properties": {
        "track": {
          "type": "string",
