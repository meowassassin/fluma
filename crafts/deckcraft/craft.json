{
 "name": "deckcraft",
 "title": "DeckCraft",
 "repo": "storytold/deckcraft",
 "kind": "프레젠테이션 (PowerPoint 류)",
 "use": "슬라이드 · 도표를 화면 재료로",
 "order": 9,
 "license": "MIT OR Apache-2.0",
 "agent": false,
 "bin": "deckcraft",
 "cli": "deckcraft-cli",
 "mcp": [
  "mcp",
  "--automation-read-root",
  "$ROOT",
  "--automation-write-root",
  "$WRITE"
 ],
 "web": true,
 "kind_en": "Presentations (PowerPoint-style)",
 "use_en": "Slides and diagrams as screen material",
 "provides": [
  {
   "material": "diagram",
   "in": "단계 · 비교 항목",
   "out": "pdf → png"
  }
 ]
}
