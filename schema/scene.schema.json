{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluma.local/schema/scene.schema.json",
  "title": "Fluma 장면 설계도 v1",
  "description": "영상 한 편의 장면 · 개체 · 움직임 · 카메라 · 에셋(권리)을 데이터로. 에이전트(감독 · 블로킹 · 프롬프트 · 생성 · 검수)와 사용자가 같은 파일을 고친다. 고치기는 scripts/scene_graph.py patch(칸 소유권 · 잠금 검사)로만. 기존 compositions/<id>/scene.js 는 code 노드로 감싼다.",
  "type": "object",
  "required": [
    "id",
    "version",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "고칠 때마다 1씩 오른다"
    },
    "fps": {
      "type": "integer",
      "enum": [
        24,
        25,
        30,
        60
      ],
      "default": 30
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2,
      "default": [
        1080,
        1920
      ]
    },
    "fidelity": {
      "enum": [
        "sketch",
        "draft",
        "final"
      ],
      "default": "final",
      "description": "sketch = 데이터 개체를 이름표 붙은 대역 상자로"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "updated": {
      "type": "string"
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "kind",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "image",
            "footage",
            "audio",
            "model3d",
            "element",
            "gen"
          ]
        },
        "src": {
          "type": "string",
          "description": "public/ 아래 상대 경로 (uploads/<id>/… · elements/<id>/… · assets3d/…)"
        },
        "rights": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "own",
                "licensed",
                "cc0",
                "cc-by",
                "generated",
                "reference-only",
                "unknown"
              ],
              "description": "reference-only · unknown 은 최종 렌더에서 막는다"
            },
            "holder": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "narration": {
          "type": "string"
        },
        "camera": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/key"
              }
            }
          },
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "key": {
      "type": "object",
      "required": [
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "장면 안 시각(초)"
        },
        "x": {
          "type": "number",
          "description": "box 기준 이동(px)"
        },
        "y": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "rot": {
          "type": "number",
          "description": "도"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ease": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "sine.inOut",
                "power2.in",
                "power2.out",
                "power2.inOut",
                "power3.out",
                "expo.out",
                "back.out"
              ]
            },
            {
              "type": "string",
              "pattern": "^cubic\\(-?\\d*\\.?\\d+,-?\\d*\\.?\\d+,-?\\d*\\.?\\d+,-?\\d*\\.?\\d+\\)$",
              "description": "사용자 곡선: cubic(x1,y1,x2,y2) — CSS cubic-bezier 와 같음"
            }
          ],
          "description": "이 키로 들어올 때의 이징"
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "code",
            "text",
            "rect",
            "ellipse",
            "image",
            "footage",
            "element",
            "gen-clip",
            "3d",
            "proxy"
          ]
        },
        "label": {
          "type": "string",
          "description": "편집기 · 대역 상자에 보일 이름"
        },
        "ref": {
          "type": "string",
          "description": "code: compositions/<id>/scene.js#<장면 번호>"
        },
        "text": {
          "type": "string"
        },
        "asset": {
          "type": "string",
          "description": "assets 의 열쇠"
        },
        "src": {
          "type": "string",
          "description": "에셋 없이 바로 쓸 때의 경로"
        },
        "in": {
          "type": "number",
          "minimum": 0,
          "description": "footage · element: 원본 안 시작(초)"
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "layer": {
          "type": "integer",
          "description": "쌓는 순서. 0 이상 = 코드 연출(scene.js) 위(z 100+layer), 음수 = 배경 바로 위 · z 를 준 코드 요소 뒤"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string"
            },
            "bg": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "weight": {
              "type": "integer"
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "radius": {
              "type": "number"
            },
            "font": {
              "type": "string"
            },
            "border": {
              "type": "string"
            }
          }
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "장면 안에서 나타나는 시각"
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "gen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spec": {
              "type": "object",
              "description": "scripts/prompt_compile.py 의 프롬프트 명세"
            },
            "model": {
              "type": "string"
            },
            "keyframe": {
              "type": "string"
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "chosen": {
              "type": [
                "integer",
                "null"
              ]
            },
            "review": {
              "type": "object"
            }
          }
        },
        "owner": {
          "enum": [
            "director",
            "previs",
            "prompt",
            "gen",
            "critic",
            "user"
          ]
        },
        "locked": {
          "type": "boolean",
          "description": "true 면 사용자만 고칠 수 있다"
        }
      }
    }
  }
}
