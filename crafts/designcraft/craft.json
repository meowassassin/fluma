{
 "name": "designcraft",
 "title": "DesignCraft",
 "repo": "storytold/designcraft",
 "kind": "지면 레이아웃 · 출판 (InDesign 류)",
 "use": "카드뉴스 · 썸네일 지면 구성",
 "order": 8,
 "license": "MIT OR Apache-2.0",
 "agent": false,
 "bin": "designcraft",
 "cli": "designcraft-cli",
 "mcp": [
  "mcp",
  "--automation-read-root",
  "$ROOT",
  "--automation-write-root",
  "$WRITE"
 ],
 "web": true,
 "kind_en": "Page layout & publishing (InDesign-style)",
 "use_en": "Card-news and thumbnail layouts",
 "provides": [
  {
   "material": "thumbnail",
   "in": "제목 · 훅 · 대표 그림 → 세로 1080×1920 + 가로 1280×720",
   "out": "png"
  },
  {
   "material": "info_card",
   "in": "제목 · 본문 · 요점 · 출처(여러 장이면 rows · csv 데이터 병합)",
   "out": "png"
  }
 ]
}
