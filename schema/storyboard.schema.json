{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shortsforge/storyboard/v1",
  "title": "Storyboard",
  "description": "영상 1편의 내용. 템플릿은 이 구조만 읽는다 (템플릿과의 계약).",
  "type": "object",
  "required": [
    "id",
    "version",
    "format",
    "duration_sec",
    "title",
    "scenes",
    "cta"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]*\\d{2}$"
    },
    "version": {
      "const": 1
    },
    "audience": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": "대상 시청자 (자유 문장). 조사·문체 기준. 2026-10-28 channel 대체"
    },
    "engine": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "hyperframes",
        "craft",
        null
      ],
      "description": "화면 합성 엔진. HyperFrames(기본) 또는 craft(Craft 앱 파이프라인: 재료 → EffectCraft → SoundCraft → FilmCraft). 예전 설명: 늘 HyperFrames(장면마다 엔진을 바꾸지 않음 — Manim · Blender · 생성 모델은 장면 안 레이어 요소)"
    },
    "template": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "엔진의 템플릿 이름. 없으면 형식으로 자동"
    },
    "format": {
      "enum": [
        "concept",
        "mythbust",
        "compare",
        "countdown",
        "fix",
        "series",
        "ad",
        "emotional",
        "daily"
      ],
      "description": "concept=한 개념 설명, mythbust=오해 깨기, compare=비교·대결, countdown=순위, fix=문제→해결, series=30초 3부작 중 1편, ad=광고(고민→제안→증거 수치→CTA), emotional=감성(현장 장면 + 짧은 문장, 숫자 최소), daily=당일 데이터(현장 + 가격 하나 + 반응)"
    },
    "brand": {
      "type": [
        "string",
        "null"
      ],
      "description": "화면 하단에 표시할 브랜드·채널 이름 (선택). 예: 호주에서 온 회전초밥"
    },
    "badge": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": "우상단 고정 배지 (예: '창업 15초', '오늘 시세'). 없으면 null"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "시안의 제약 (예: '유튜브 영상 스틸만 사용'). 생성층·렌더층이 읽는다"
    },
    "duration_sec": {
      "type": "integer",
      "minimum": 15,
      "maximum": 60
    },
    "title": {
      "type": "string",
      "maxLength": 40,
      "description": "유튜브 제목 (해시태그 제외)"
    },
    "topic": {
      "type": "string",
      "description": "입력된 주제 원문"
    },
    "hook_number": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 6,
      "description": "숫자 도장용 핵심 숫자 (예: '37%', '3개', '0원'). 없으면 null"
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "cta": {
      "type": "string",
      "maxLength": 20
    },
    "caption": {
      "type": "string",
      "maxLength": 300,
      "description": "플랫폼 게시글 본문"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#"
      },
      "maxItems": 10
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "of": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "생성 과정 기록. 템플릿은 읽지 않는다.",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "llm_calls": {
          "type": "integer"
        },
        "escalated": {
          "type": "boolean"
        },
        "lint_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "character": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9-]+$",
      "description": "characters/<이름>/ — 화면 구석에서 나레이션에 맞춰 립싱크하는 캐릭터. null 이면 끔"
    },
    "reference": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "참고한 트렌드 쇼츠 id (public/trends/analysis/<id>.json) — 편집기에 참고 리듬으로 표시"
    },
    "direction": {
      "type": "object",
      "description": "디자인 방향(scripts/direct.py): 바탕 · 색 · 글자 · 배치 · 움직임 · 전환 · 자막 · 주인공 장치. 영상마다 다르게, 컴포지션은 이것을 따른다",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "description": "나레이션 음성 엔진 · 목소리 (voices/<엔진>). 없으면 설정의 기본 음성",
      "properties": {
        "engine": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.6,
          "description": "말 속도 (1 = 엔진 기본). 엔진이 직접 빠르게 말한다"
        },
        "style": {
          "type": "string",
          "maxLength": 400,
          "description": "말투 지시(글). Gemini TTS 처럼 연기 지시를 받는 엔진에 넘긴다 — 예: 친구한테 소식 전하듯 빠르고 가볍게"
        },
        "continuous": {
          "type": "boolean",
          "description": "이어 말하기: 대본 전체를 한 번에 합성하고 장면은 단어 사이 쉼에서 자른다(컷이 바뀌어도 말이 이어짐)"
        },
        "ending": {
          "type": "string",
          "enum": [
            "keep",
            "period"
          ],
          "description": "말끝 처리(모든 엔진): period = 합성할 때만 문장 중간 쉼표를 마침표로 — 말끝이 올라가지 않고 떨어져 더 딱딱 · 담담하게. 자막 글은 그대로"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "감정 강도(typecast 감정 프리셋, 기본 1) — 작을수록 평평"
        },
        "pitch": {
          "type": "integer",
          "minimum": -12,
          "maximum": 12,
          "description": "음높이(반음, typecast) — 레퍼런스 화자 높이에 맞출 때 voice_match.py 가 정한다"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "description": "의도 카드 — 사용자가 원하는 것을 구조로 적는다(기억이 아니라 이 영상의 규칙). 확인(confirmed)되기 전엔 제작 · 유료 생성을 하지 않는다",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 300,
          "description": "한 줄: 누구에게 무엇을 어떤 느낌으로"
        },
        "reference_use": {
          "type": "string",
          "maxLength": 300,
          "description": "레퍼런스에서 가져올 것(구성 · 말투 · 화면 · 목소리 중 무엇을)과 가져오지 않을 것"
        },
        "must": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "꼭 지킬 것 — 사용자 지적이 나올 때마다 한 줄씩 더한다"
        },
        "must_not": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "하지 말 것 — 예: 직접 그린 2D · 이모지(AI 티) · 빨간 네모 강조"
        },
        "locked": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "content",
              "tone",
              "screen",
              "voice",
              "length"
            ]
          },
          "description": "사용자가 확정해 바꾸면 안 되는 축 — content 가 잠기면 말투 수정은 tone_edit.py 로만"
        },
        "confirmed": {
          "type": "boolean",
          "description": "사용자가 의도 카드를 확인했는지(gate.py intent 로만 켠다)"
        }
      }
    },
    "preset": {
      "type": "object",
      "description": "형식 프리셋(scripts/format_presets.py pick) — 사람이 편집한 실제 쇼츠에서 잰 숫자: 자막 위치 · 크기 · 글자 수, 고정 제목, 화면 채움, 컷 길이, 화면 종류 비율. 화면 부품(K.talk · K.fmt)이 이 숫자로 배치한다",
      "additionalProperties": true
    },
    "language": {
      "type": "string",
      "enum": [
        "ko",
        "en",
        "zh"
      ],
      "default": "ko",
      "description": "나레이션 · 자막 언어(화면 UI 언어와 별개). 말 속도 검사 · 자막 줄 길이 · 말투 검사가 이것을 따른다"
    },
    "punchline": {
      "type": "string",
      "maxLength": 40,
      "description": "영상 내내 떠 있는 고정 펀치라인(참고 쇼츠 문법에 punch 자리가 있을 때) — 예: '아빠는 하품할때만 우는데'"
    },
    "grammar": {
      "type": "object",
      "additionalProperties": true,
      "description": "참고 쇼츠의 화면 문법(scripts/previz.py grammar): 고정 제목 · 펀치라인 · 상황 괄호 · 반응 자막 · 속마음 · 영상 칸의 위치 · 크기 · 색. K.talk.gram 이 읽는다"
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "description": "배경음악(scripts/finish.py 가 마무리 때 섞는다). 권리는 사용자 판단 — 엔진은 사용자가 지정한 파일만 섞는다",
      "properties": {
        "src": {
          "type": "string",
          "description": "음악 파일 경로(저장소 기준, 예: public/uploads/<id>/song.mp3)"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "곡의 몇 초부터 쓸지(후렴 · 드롭에 맞추기)"
        },
        "gain_db": {
          "type": "number",
          "minimum": -40,
          "maximum": 6,
          "description": "음량(dB). 기본 -14 — 나레이션이 있으면 그 밑에 깔린다"
        },
        "duck": {
          "type": "boolean",
          "description": "말할 때 음악을 줄인다(기본 true)"
        },
        "fade_in": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "fade_out": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        }
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "role",
        "sec",
        "caption",
        "narration",
        "visual"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "hook",
            "setup",
            "item",
            "contrast",
            "step",
            "reveal",
            "verdict",
            "outro",
            "benefit",
            "proof",
            "mood",
            "price",
            "cta"
          ],
          "description": "hook=첫 3초, setup=문제 제시, item=항목(비교·순위), contrast=통념 vs 사실, step=절차 한 단계, reveal=핵심 공개, verdict=결론, outro=CTA·루프 연결, benefit=광고 이점 하나, proof=증거(수치·현장), mood=감성 장면, price=가격 하나, cta=행동 유도"
        },
        "sec": {
          "type": "number",
          "minimum": 2,
          "maximum": 12
        },
        "caption": {
          "type": "string",
          "maxLength": 28,
          "description": "화면 자막. 2줄 이내, 줄바꿈은 \\n"
        },
        "narration": {
          "type": "string",
          "maxLength": 60,
          "description": "음성 대사. 초당 4~5자 기준으로 sec에 맞춤"
        },
        "visual": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "number",
                "text",
                "compare",
                "list",
                "diff",
                "code",
                "screenshot",
                "icon",
                "chart",
                "still",
                "footage",
                "price_tag",
                "audio_demo"
              ],
              "description": "템플릿이 그릴 화면 종류. still=사진 위 자막(켄번스), footage=영상 위 자막, price_tag=현장 사진/영상 + 가격 하나 크게, audio_demo=음성 샘플 재생 + 파형. 분석 결과 still/footage/price_tag가 1순위 증거"
            },
            "motion": {
              "enum": [
                "kenburns_in",
                "kenburns_out",
                "pan_left",
                "pan_right",
                "static"
              ],
              "description": "still/footage 의 움직임"
            },
            "primary": {
              "type": "string",
              "description": "강조 값 (숫자, 항목명, 아이콘 id 등)"
            },
            "secondary": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 5
            },
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            },
            "asset": {
              "type": "string",
              "description": "public/ 기준 경로: captures/… · uploads/<id>/<파일>(사용자가 올린 사진 · 영상) · elements/<id>/<이름>(scripts/element.py 레이어 요소)"
            },
            "emphasis": {
              "enum": [
                "good",
                "bad",
                "neutral"
              ],
              "default": "neutral"
            },
            "clip_start": {
              "type": "number",
              "minimum": 0,
              "description": "footage(올린 실사 영상)에서 쓸 시작 초 — 장면 길이만큼 이어서 씀(트림)"
            },
            "src": {
              "type": "string",
              "description": "쓸 재료 파일(public/ 아래: 그림 또는 프레임 폴더). 없으면 미리 보기에서 회색 자리표시 카드"
            }
          }
        },
        "sfx": {
          "anyOf": [
            {
              "enum": [
                "stamp",
                "pop",
                "tick",
                "swoosh",
                "none"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "stamp",
                      "pop",
                      "tick",
                      "swoosh"
                    ]
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          ],
          "default": "none",
          "description": "효과음. 문자열 = 장면 시작, 배열 = [{name, at(장면 안 초)}] 화면 동작 순간에"
        },
        "music_cue": {
          "enum": [
            "up",
            "calm",
            "drop",
            "none"
          ],
          "description": "감성/광고용 음악 포인트"
        },
        "engine": {
          "type": "string",
          "enum": [
            "hyperframes"
          ],
          "description": "(예전 필드) 장면은 모두 HyperFrames 가 합성한다"
        },
        "template": {
          "type": "string",
          "description": "이 장면의 엔진 템플릿. 없으면 콘티 template(같은 엔진일 때) 또는 자동"
        },
        "elements": {
          "type": "array",
          "maxItems": 12,
          "description": "이 장면에 필요한 시각 요소(장면 설계 단계에서 정함 → 요소 준비 → scene.js 배치). 대부분 2D(kit), 3D 는 움직여야 사는 개체 하나만",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 40,
                "description": "scene.js 의 name 과 같게 (예: \"GitHub 로고\", \"S3 버킷\", \"데이터 입자\")"
              },
              "what": {
                "type": "string",
                "maxLength": 120,
                "description": "무엇을 · 어떻게 움직이는지 한 줄"
              },
              "source": {
                "type": "string",
                "enum": [
                  "kit",
                  "icon",
                  "manim",
                  "blender",
                  "library",
                  "gen",
                  "upload",
                  "capture",
                  "webrec",
                  "meme"
                ],
                "description": "kit=HyperFrames 도형 · 글자 · 선 · UI / icon=scripts/icons.py / manim=정밀 도표 / blender=3D 개체 하나 / library=library3d 재사용 / gen=생성 모델 / upload=사용자 파일 / capture=화면 캡처 / webrec=웹 화면 녹화(scripts/webrec.py → K.web)"
              },
              "reuse": {
                "type": "string",
                "maxLength": 60,
                "description": "library3d 이름 (source=library)"
              },
              "cue": {
                "type": "string",
                "maxLength": 30,
                "description": "이 요소가 등장 · 움직이는 나레이션 단어 (scene.js 에서 c.cue(\"…\"))"
              }
            }
          }
        },
        "beat": {
          "type": "string",
          "maxLength": 120,
