 "kind": "오디오 녹음 · 믹스 (Pro Tools 류)",
 "use": "나레이션 · 배경음악 · 효과음 믹스, 직접 녹음",
 "order": 5,
 "license": "MIT OR Apache-2.0",
 "agent": true,
