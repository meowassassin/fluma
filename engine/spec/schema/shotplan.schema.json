{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Fluma 샷 계획 (파이프라인 1단계 출력)",
 "description": "기획 기록(data/shotplans/<id>.json) — 주제 · 트렌드 근거 · 경로 · 자료조사 · 시각 레퍼런스. 실제 제작은 콘티(storyboard)에서",
 "type": "object",
 "required": [
  "id",
  "topic",
  "aspect"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
  },
  "topic": {
   "type": "string",
   "minLength": 2
  },
  "aspect": {
   "enum": [
    "9:16",
    "16:9"
   ],
   "description": "쇼츠는 9:16 — 이미지 · 영상 생성 모두 파라미터로 넘긴다(프롬프트 글로 정하지 않음)"
  },
  "trend": {
   "type": "object",
   "description": "1단계 입력이 된 기존 트렌드 분석 — 어떤 추천 선택지에서 왔나",
   "additionalProperties": false,
   "properties": {
    "request": {
     "type": "string"
    },
    "refs": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "option": {
     "type": "string",
     "description": "사용자가 고른(또는 말한) 추천 선택지"
    },
    "why": {
     "type": "string"
    }
   }
  },
  "logline": {
   "type": "string"
  },
  "title": {
   "type": "string",
   "maxLength": 40,
   "description": "영상 제목(업로드 · 화면 제목)"
  },
  "cta": {
   "type": "string",
   "maxLength": 20
  },
  "format": {
   "enum": [
    "concept",
    "mythbust",
    "compare",
    "countdown",
    "fix",
    "series",
    "ad",
    "emotional",
    "daily",
    "ranking",
    "clip"
   ],
   "description": "편집 엔진 형식(기본 concept)"
  },
  "route": {
   "enum": [
    "clip",
    "material"
   ],
   "description": "1단계 경로 — clip 클립 재편집(dub.py) · material 실제 자료 편집(storyboard · produce.py). 영상 생성 경로는 2026-11-19 제거"
  },
  "route_why": {
   "type": "string",
   "description": "그 경로를 고른 이유 한 줄(사용자에게 보인 것)"
  },
  "handoff": {
   "type": "string",
   "description": "생성이 아닌 경로에서 이어 갈 파일(dub.json 또는 콘티)"
  },
  "route_by": {
   "enum": [
    "user",
    "default"
   ],
   "description": "경로를 누가 정했나 — user 사용자가 고름 · default 사용자가 '알아서'라고 해 에이전트 추천대로"
  },
  "made_by": {
   "type": "object",
   "description": "기획한 에이전트(실행 기록 — FLUMA_AGENT_RUNTIME · MODEL). 설정이 바뀌어도 이 기록은 그대로",
   "properties": {
    "runtime": {
     "type": [
      "string",
      "null"
     ]
    },
    "model": {
     "type": [
      "string",
      "null"
     ]
    },
    "at": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "style_refs": {
   "type": "array",
   "maxItems": 4,
   "description": "Stage 0.5 에서 눈으로 확인해 고른 화풍 · 작품 · 소품 · 배경 참조 이미지(콘티 direction · 재료 고를 때 참고)",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "role"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "role": {
      "enum": [
       "style",
       "character",
       "prop",
       "background"
      ]
     },
     "note": {
      "type": "string"
     },
     "source": {
      "type": "string"
     }
    }
   }
  },
  "style_ref_skip": {
   "type": "string",
   "description": "외부 시각 레퍼런스 이미지를 쓰지 않는 이유(순수 일반 창작 · 이미 캐릭터 시트/유튜브 레퍼런스 확보 등)"
  },
  "research": {
   "type": "object",
   "additionalProperties": false,
   "description": "Stage 0.5 주제 자료조사 요약(data/research/<id>.json 연결 또는 건너뜀 사유)",
   "properties": {
    "file": {
     "type": "string"
    },
    "facts_count": {
     "type": "integer",
     "minimum": 0
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "visual_entities": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "skip_reason": {
     "type": "string"
    }
   }
  }
 }
}
